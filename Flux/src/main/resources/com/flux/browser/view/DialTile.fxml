<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.flux.browser.controller.DialTileController"
      prefWidth="282" minWidth="180" prefHeight="98" spacing="8" styleClass="dial-tile" stylesheets="@../style.css">
    <Button fx:id="openButton" onAction="#open" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="dial-open">
        <graphic>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="monogram" text="G" alignment="CENTER" minWidth="36" prefWidth="36" prefHeight="36" styleClass="dial-monogram"/>
                <Label fx:id="titleLabel" text="GitHub" styleClass="dial-title" minWidth="0" maxWidth="190"/>
            </HBox>
        </graphic>
    </Button>
    <HBox alignment="CENTER_LEFT" spacing="6">
        <Label fx:id="domainLabel" text="github.com" styleClass="dial-domain" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <Button fx:id="editButton" text="Edit" onAction="#edit" styleClass="tile-action" accessibleText="Edit shortcut"/>
        <Button fx:id="deleteButton" text="×" onAction="#delete" styleClass="tile-action" accessibleText="Remove shortcut"/>
    </HBox>
</VBox>
