<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import com.flux.browser.ui.WallpaperCanvas?>
<?import com.flux.browser.ui.ChromeContour?>
<StackPane fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.flux.browser.controller.BrowserController" styleClass="browser-root" stylesheets="@../style.css">
    <WallpaperCanvas fx:id="wallpaperCanvas" managed="false"/>
    <BorderPane fx:id="shell" styleClass="floating-shell">
    <!-- 46 px rail surface with 32 px buttons; the 4 px gutter is outside it. -->
    <left><VBox styleClass="window-rail" alignment="TOP_CENTER" prefWidth="46" minWidth="46" maxWidth="46">
      <BorderPane.margin><Insets right="4"/></BorderPane.margin>
      <VBox spacing="9" alignment="CENTER" styleClass="traffic-lights">
       <Button text="" onAction="#quit" styleClass="traffic,traffic-close" accessibleText="Close window"/>
       <Button text="" onAction="#minimize" styleClass="traffic,traffic-minimize" accessibleText="Minimize window"/>
       <Button fx:id="maximizeButton" text="" onAction="#maximize" styleClass="traffic,traffic-maximize" accessibleText="Maximize or restore window"/>
      </VBox>
      <Button fx:id="workspacesButton" onAction="#workspaces" styleClass="sidebar-button" accessibleText="Workspaces">
       <graphic><SVGPath content="M 1 5 L 14 5 L 14 18 L 1 18 Z M 5 1 L 18 1 L 18 14" styleClass="line-icon"/></graphic>
       <tooltip><Tooltip text="Workspaces · organize your tabs"/></tooltip>
      </Button>
      <fx:include fx:id="sidebar" source="Sidebar.fxml" VBox.vgrow="ALWAYS"/>
     </VBox></left>
    <center>
        <BorderPane>
            <top>
                <VBox>
                    <BorderPane.margin><Insets bottom="4"/></BorderPane.margin>
                    <HBox styleClass="tab-strip" alignment="CENTER_LEFT" spacing="6">
                        <ScrollPane fx:id="tabScroll" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="NEVER" pannable="true" HBox.hgrow="NEVER" minWidth="100" styleClass="tab-scroll">
                            <content><HBox fx:id="tabHeaders" alignment="CENTER_LEFT" spacing="6"/></content>
                        </ScrollPane>
                        <Button fx:id="newTabButton" text="+" styleClass="icon-button,new-tab-button" onAction="#newTab" accessibleText="New tab">
                            <tooltip><Tooltip text="New tab · Ctrl/Cmd+T"/></tooltip>
                        </Button>
                        <Region HBox.hgrow="ALWAYS" fx:id="titleDrag" minWidth="35" prefWidth="100" onMousePressed="#beginDrag" onMouseDragged="#dragWindow" onMouseClicked="#titleClicked"/>
                    </HBox>
                    <StackPane styleClass="floating-navigation">
                        <VBox.margin><Insets top="4"/></VBox.margin>
                        <HBox styleClass="navigation-strip" alignment="CENTER_LEFT" spacing="3">
                            <Button fx:id="backButton" onAction="#back" styleClass="icon-button" accessibleText="Back">
                                <graphic><SVGPath content="M 11 2 L 4 9 L 11 16" styleClass="line-icon"/></graphic>
                                <tooltip><Tooltip text="Back · Alt+Left"/></tooltip>
                            </Button>
                            <Button fx:id="forwardButton" onAction="#forward" styleClass="icon-button" accessibleText="Forward">
                                <graphic><SVGPath content="M 4 2 L 11 9 L 4 16" styleClass="line-icon"/></graphic>
                                <tooltip><Tooltip text="Forward · Alt+Right"/></tooltip>
                            </Button>
                            <Button fx:id="reloadButton" onAction="#reload" styleClass="icon-button" accessibleText="Reload page">
                                <graphic><SVGPath content="M 15 6 A 7 7 0 1 0 16 12 M 15 1 L 15 6 L 10 6" styleClass="line-icon"/></graphic>
                                <tooltip><Tooltip text="Reload · Ctrl/Cmd+R"/></tooltip>
                            </Button>
                            <Button fx:id="stopButton" onAction="#stopLoading" styleClass="icon-button" accessibleText="Stop loading">
                                <graphic><SVGPath content="M 3 3 L 13 13 M 13 3 L 3 13" styleClass="line-icon"/></graphic>
                                <tooltip><Tooltip text="Stop · Escape"/></tooltip>
                            </Button>
                            <Button fx:id="homeButton" onAction="#home" styleClass="icon-button" accessibleText="Speed Dial home">
                                <graphic><SVGPath content="M 1 8 L 9 1 L 17 8 M 4 6 L 4 16 L 14 16 L 14 6 M 7 16 L 7 11 L 11 11 L 11 16" styleClass="line-icon"/></graphic>
                                <tooltip><Tooltip text="Home · Alt+Home"/></tooltip>
                            </Button>
                            <HBox styleClass="address-box" alignment="CENTER_LEFT" spacing="8" minWidth="0" HBox.hgrow="ALWAYS">
                                <Label fx:id="schemeLabel" text="⌕" styleClass="scheme-label" minWidth="18"/>
                                <TextField fx:id="addressBar" minWidth="40" promptText="Enter search or web address" onAction="#navigate" HBox.hgrow="ALWAYS" styleClass="address-input" accessibleText="Web address or search query"/>
                                <Button fx:id="bookmarkButton" text="☆" onAction="#toggleBookmark" styleClass="bookmark-button" accessibleText="Bookmark this page">
                                    <tooltip><Tooltip text="Toggle bookmark · Ctrl/Cmd+D"/></tooltip>
                                </Button>
                            </HBox>
                            <Button fx:id="featuresButton" onAction="#features" styleClass="icon-button" accessibleText="Browser tools">
                             <graphic><SVGPath content="M 0 0 L 7 0 L 7 7 L 0 7 Z M 12 0 L 19 0 L 19 7 L 12 7 Z M 0 12 L 7 12 L 7 19 L 0 19 Z M 12 12 L 19 12 L 19 19 L 12 19 Z" styleClass="line-icon"/></graphic>
                             <tooltip><Tooltip text="Browser tools"/></tooltip>
                            </Button>
                            <Button fx:id="easySetupButton" onAction="#easySetup" styleClass="icon-button" accessibleText="Easy Setup">
                             <graphic><SVGPath content="M 0 3 L 18 3 M 0 9 L 18 9 M 0 15 L 18 15 M 5 0 L 5 6 M 13 6 L 13 12 M 7 12 L 7 18" styleClass="line-icon"/></graphic>
                             <tooltip><Tooltip text="Easy Setup"/></tooltip>
                            </Button>
                        </HBox>
                        <ProgressBar fx:id="loadProgress" progress="0" maxWidth="Infinity" prefHeight="2" minHeight="2" maxHeight="2" StackPane.alignment="BOTTOM_CENTER" mouseTransparent="true" styleClass="page-progress"/>
                    </StackPane>
                    <HBox fx:id="documentBar" visible="false" managed="false" spacing="10" style="-fx-padding:8;" alignment="CENTER_LEFT">
                        <Label text="PDF viewer"/><Button text="Previous page" onAction="#pdfPrevious"/><Button text="Next page" onAction="#pdfNext"/><Button text="−" onAction="#pdfZoomOut"/><Button text="+" onAction="#pdfZoomIn"/>
                    </HBox>
                    <Label fx:id="toastText" visible="false" managed="false" wrapText="true" maxWidth="Infinity" styleClass="toast-notice"/>
                </VBox>
            </top>
            <center>
                <BorderPane fx:id="contentLayout"><center><StackPane fx:id="contentHost">
                    <StackPane fx:id="tabHost"/>
                    <fx:include fx:id="library" source="Library.fxml"/>
                    <fx:include fx:id="settings" source="Settings.fxml"/>
                    <fx:include fx:id="features" source="Features.fxml"/>
                    <fx:include fx:id="downloadsPage" source="Downloads.fxml"/>
                    <fx:include fx:id="historyPanel" source="HistoryPanel.fxml"/>
                </StackPane></center><right><fx:include fx:id="easySetup" source="EasySetup.fxml"/></right></BorderPane>
            </center>
            <bottom>
                <HBox fx:id="statusBar" styleClass="status-bar" alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="databaseStatus" text="●  CONNECTING STORAGE" styleClass="storage-label"/>
                    <Label fx:id="statusText" text="Ready to explore" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="0"/>
                    <Label fx:id="tabCount" text="1 TAB" styleClass="status-meta"/>
                    <Label text="◢" styleClass="resize-grip" onMousePressed="#beginResize" onMouseDragged="#resizeWindow" accessibleText="Drag to resize window"/>
                </HBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
<ChromeContour fx:id="chromeContour" managed="false"/>
<Label text="◢" StackPane.alignment="BOTTOM_RIGHT" styleClass="window-resize" onMousePressed="#beginResize" onMouseDragged="#resizeWindow" accessibleText="Drag to resize window"/>
</StackPane>
