<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.flux</groupId>
    <artifactId>flux-browser</artifactId>
    <version>1.0.0</version>
    <name>Flux Browser</name>
    <description>A lightweight, FXML-authored JavaFX browser with PostgreSQL persistence.</description>
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.12</javafx.version>
        <postgresql.version>42.7.13</postgresql.version>
        <!-- Compatibility fallback; modern macOS uses Metal for web/video composition below. -->
        <flux.rendering>sw</flux.rendering>
        <flux.maxHeap>1024m</flux.maxHeap>
        <flux.fullspeed>false</flux.fullspeed>
        <flux.showFps>false</flux.showFps>
        <flux.consoleLogging>false</flux.consoleLogging>
        <flux.engine>native</flux.engine>
        <flux.mainClass>com.flux.browser/com.flux.browser.FluxBrowser</flux.mainClass>
    </properties>
    <dependencies>
        <dependency><groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.13.2</version></dependency>
        <dependency>
            <groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId><artifactId>javafx-fxml</artifactId><version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId><artifactId>javafx-web</artifactId><version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><version>${postgresql.version}</version>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource><directory>src/main/resources</directory></resource>
            <resource>
                <directory>database</directory><targetPath>db</targetPath>
                <includes><include>schema.sql</include></includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.0</version>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration><useModulePath>false</useModulePath></configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.3</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId><artifactId>javafx-maven-plugin</artifactId><version>0.0.8</version>
                <configuration>
                    <mainClass>${flux.mainClass}</mainClass>
                    <options>
                        <option>--enable-native-access=com.flux.browser,javafx.graphics,javafx.web,javafx.media</option>
                        <option>--add-exports=javafx.graphics/com.sun.javafx.stage=com.flux.browser</option>
                        <option>--add-exports=javafx.graphics/com.sun.javafx.tk=com.flux.browser</option>
                        <option>-Dflux.engine=${flux.engine}</option>
                        <option>-Dflux.consoleLogging=${flux.consoleLogging}</option>
                        <option>--add-exports=javafx.web/com.sun.javafx.webkit=com.flux.browser</option>
                        <option>-Xms64m</option>
                        <option>-Xmx${flux.maxHeap}</option>
                        <option>-Dprism.order=${flux.rendering}</option>
                        <option>-Djavafx.animation.fullspeed=${flux.fullspeed}</option>
                        <option>-Dprism.showfps=${flux.showFps}</option>
                    </options>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
                <executions>
                    <execution>
                        <id>browser-checks</id><phase>test</phase><goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>com.flux.browser.BrowserChecks</mainClass><classpathScope>test</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>module-ui-check</id>
            <properties><flux.mainClass>com.flux.browser/com.flux.browser.BrowserSmokeChecks</flux.mainClass></properties>
            <build><plugins><plugin>
                <groupId>org.openjfx</groupId><artifactId>javafx-maven-plugin</artifactId>
                <configuration><options combine.children="append">
                    <option>--patch-module=com.flux.browser=${project.build.testOutputDirectory}</option>
                    <option>--add-modules=jdk.httpserver,java.desktop</option>
                    <option>-Dflux.testInput=true</option><option>-Dflux.session=false</option>
                </options></configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>mac-webkit</id>
            <activation><os><family>mac</family></os></activation>
            <build><plugins><plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
                <executions><execution>
                    <id>build-native-webkit</id><phase>generate-resources</phase><goals><goal>exec</goal></goals>
                    <configuration>
                        <executable>/bin/sh</executable>
                        <arguments><argument>${project.basedir}/src/main/native/build.sh</argument>
                            <argument>${java.home}</argument><argument>${project.build.outputDirectory}</argument><argument>${os.arch}</argument></arguments>
                    </configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>mac-metal</id>
            <activation><jdk>[24,)</jdk><os><family>mac</family></os></activation>
            <properties><flux.rendering>mtl,es2,sw</flux.rendering></properties>
        </profile>
        <profile>
            <id>web-media-check</id>
            <properties><flux.renderScale>0</flux.renderScale></properties>
            <build><plugins><plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
                <executions><execution>
                    <id>web-media-checks</id><phase>integration-test</phase><goals><goal>exec</goal></goals>
                    <configuration>
                        <executable>${java.home}/bin/java</executable><classpathScope>test</classpathScope>
                        <arguments>
                            <argument>--enable-native-access=ALL-UNNAMED</argument>
                            <argument>-Dflux.testInput=true</argument><argument>-Dflux.session=false</argument>
                            <argument>-Dflux.engine=${flux.engine}</argument>
                            <argument>-Xms64m</argument>
                            <argument>-Xmx${flux.maxHeap}</argument>
                            <argument>-Dprism.order=${flux.rendering}</argument>
                            <argument>-Dprism.verbose=true</argument>
                            <argument>-Dflux.renderScale=${flux.renderScale}</argument>
                            <argument>-cp</argument><classpath/>
                            <argument>com.flux.browser.WebMediaChecks</argument>
                        </arguments>
                    </configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>performance-check</id>
            <properties><flux.check.lazy>true</flux.check.lazy><flux.engine>javafx</flux.engine></properties>
            <build><plugins><plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
                <executions><execution>
                    <id>performance-checks</id><phase>integration-test</phase><goals><goal>exec</goal></goals>
                    <configuration>
                        <executable>${java.home}/bin/java</executable><classpathScope>test</classpathScope>
                        <arguments>
                            <argument>--enable-native-access=ALL-UNNAMED</argument>
                            <argument>-Dflux.engine=${flux.engine}</argument>
                            <argument>-Xms64m</argument>
                            <argument>-Xmx${flux.maxHeap}</argument>
                            <argument>-Dprism.order=${flux.rendering}</argument>
                            <argument>-Dprism.verbose=true</argument>
                            <argument>-Dflux.check.lazy=${flux.check.lazy}</argument><argument>-Dflux.session=false</argument>
                            <argument>-cp</argument><classpath/>
                            <argument>com.flux.browser.PerformanceChecks</argument>
                        </arguments>
                    </configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>modern-jdk</id>
            <activation><jdk>[24,)</jdk></activation>
            <!-- New JDKs need JavaFX's own JSObject module for the WebKit JavaScript bridge. -->
            <properties><javafx.version>26.0.2</javafx.version></properties>
        </profile>
        <profile>
            <id>database-check</id>
            <build><plugins><plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
                <executions><execution>
                    <id>database-checks</id><phase>integration-test</phase><goals><goal>java</goal></goals>
                    <configuration><mainClass>com.flux.browser.DatabaseChecks</mainClass><classpathScope>test</classpathScope></configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>ui-check</id>
            <build><plugins><plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
                <executions><execution>
                    <id>ui-checks</id><phase>integration-test</phase><goals><goal>exec</goal></goals>
                    <configuration>
                        <executable>${java.home}/bin/java</executable><classpathScope>test</classpathScope>
                        <arguments>
                            <argument>--enable-native-access=ALL-UNNAMED</argument>
                            <argument>-Dflux.testInput=true</argument><argument>-Dflux.session=false</argument>
                            <argument>-Dflux.engine=${flux.engine}</argument>
                            <argument>-Xms64m</argument>
                            <argument>-Xmx${flux.maxHeap}</argument>
                            <argument>-Dprism.order=${flux.rendering}</argument>
                            <argument>-cp</argument><classpath/>
                            <argument>com.flux.browser.BrowserSmokeChecks</argument>
                        </arguments>
                    </configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>feature-ui-check</id>
            <build><plugins><plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
                <executions><execution>
                    <id>feature-ui-checks</id><phase>integration-test</phase><goals><goal>exec</goal></goals>
                    <configuration>
                        <executable>${java.home}/bin/java</executable><classpathScope>test</classpathScope>
                        <arguments>
                            <argument>--enable-native-access=ALL-UNNAMED</argument>
                            <argument>-Dflux.testInput=true</argument><argument>-Dflux.session=false</argument>
                            <argument>-Dflux.engine=${flux.engine}</argument>
                            <argument>-Xms64m</argument>
                            <argument>-Xmx${flux.maxHeap}</argument>
                            <argument>-Dprism.order=${flux.rendering}</argument>
                            <argument>-cp</argument><classpath/>
                            <argument>com.flux.browser.FeatureUiChecks</argument>
                        </arguments>
                    </configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
