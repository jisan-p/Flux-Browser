<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>

<HBox alignment="CENTER_LEFT"
      prefHeight="42.0"
      spacing="6.0"
      styleClass="tab-strip"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.custombrowser.ui.component.TabStripController">
    <children>
        <ScrollPane fx:id="tabScroller"
                    fitToHeight="true"
                    hbarPolicy="AS_NEEDED"
                    vbarPolicy="NEVER"
                    pannable="true"
                    styleClass="tab-scroller"
                    HBox.hgrow="ALWAYS">
            <content>
                <HBox fx:id="tabHeaders"
                      alignment="CENTER_LEFT"
                      spacing="5.0"/>
            </content>
        </ScrollPane>
        <Button text="+"
                focusTraversable="false"
                onAction="#newTab"
                styleClass="new-tab-button">
            <tooltip><Tooltip text="New tab (Ctrl/Command+T)"/></tooltip>
        </Button>
        <Button text="↶"
                focusTraversable="false"
                onAction="#reopenClosedTab"
                styleClass="new-tab-button">
            <tooltip><Tooltip text="Reopen closed tab"/></tooltip>
        </Button>
        <Pane minWidth="8.0"/>
    </children>
</HBox>
