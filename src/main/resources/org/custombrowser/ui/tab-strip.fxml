<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>

<HBox alignment="CENTER_LEFT"
      prefHeight="42.0"
      spacing="6.0"
      styleClass="tab-strip"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.custombrowser.ui.component.TabStripController">
    <children>
        <HBox alignment="CENTER_LEFT"
              minWidth="210.0"
              prefWidth="240.0"
              maxWidth="280.0"
              spacing="8.0"
              styleClass="active-tab">
            <children>
                <Button text="◆"
                        focusTraversable="false"
                        onAction="#showStartPage"
                        styleClass="tab-favicon"/>
                <Label fx:id="tabTitle"
                       text="Start Page"
                       maxWidth="190.0"
                       styleClass="tab-title"
                       HBox.hgrow="ALWAYS"/>
                <Button text="×"
                        focusTraversable="false"
                        onAction="#showStartPage"
                        styleClass="tab-close"/>
            </children>
        </HBox>
        <Button text="+"
                focusTraversable="false"
                onAction="#showStartPage"
                styleClass="new-tab-button"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label text="WORKSPACE 1" styleClass="workspace-label"/>
    </children>
</HBox>
