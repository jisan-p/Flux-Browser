<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="panelRoot" spacing="9.0" styleClass="data-panel"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <TextField fx:id="historySearch" promptText="Search browsing history"
                   styleClass="panel-search"/>
        <Label text="Double-click a visit to open it." styleClass="muted-copy"/>
        <ListView fx:id="historyList" styleClass="data-list"
                  VBox.vgrow="ALWAYS"/>
        <Label fx:id="historyStatus" text="0 VISITS" styleClass="data-status"/>
        <HBox spacing="6.0">
            <children>
                <Button text="DELETE SELECTED" onAction="#deleteSelectedVisit"
                        styleClass="compact-action"/>
                <Button text="CLEAR ALL" onAction="#clearHistory"
                        styleClass="danger-action"/>
            </children>
        </HBox>
    </children>
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
</VBox>
