<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>

<HBox alignment="CENTER_LEFT"
      prefHeight="52.0"
      spacing="7.0"
      styleClass="navigation-bar"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.custombrowser.ui.component.NavigationBarController">
    <children>
        <Button fx:id="backButton"
                text="‹"
                disable="true"
                onAction="#back"
                styleClass="nav-button">
            <tooltip><Tooltip text="Back"/></tooltip>
        </Button>
        <Button fx:id="forwardButton"
                text="›"
                disable="true"
                onAction="#forward"
                styleClass="nav-button">
            <tooltip><Tooltip text="Forward"/></tooltip>
        </Button>
        <Button fx:id="reloadButton"
                text="↻"
                onAction="#reloadOrStop"
                styleClass="nav-button">
            <tooltip><Tooltip text="Reload or stop"/></tooltip>
        </Button>
        <Button text="⌂"
                onAction="#home"
                styleClass="nav-button">
            <tooltip><Tooltip text="Start page"/></tooltip>
        </Button>

        <HBox alignment="CENTER_LEFT"
              spacing="7.0"
              styleClass="omnibox"
              HBox.hgrow="ALWAYS">
            <children>
                <Label text="◇" styleClass="security-indicator"/>
                <TextField fx:id="addressField"
                           promptText="Enter a search or web address"
                           onAction="#submitAddress"
                           styleClass="address-field"
                           HBox.hgrow="ALWAYS"/>
                <Button text="☆"
                        focusTraversable="false"
                        styleClass="omnibox-action">
                    <tooltip><Tooltip text="Bookmarking arrives in Phase 3"/></tooltip>
                </Button>
            </children>
        </HBox>

        <Button text="◫"
                focusTraversable="false"
                styleClass="toolbar-button">
            <tooltip><Tooltip text="Snapshot placeholder"/></tooltip>
        </Button>
        <Button text="☰"
                focusTraversable="false"
                onAction="#easySetup"
                styleClass="easy-setup-button">
            <tooltip><Tooltip text="Easy Setup"/></tooltip>
        </Button>
    </children>
</HBox>
