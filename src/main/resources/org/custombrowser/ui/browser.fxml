<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<StackPane fx:id="browserRoot"
           prefWidth="1280.0"
           prefHeight="800.0"
           styleClass="browser-root"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.custombrowser.ui.BrowserController">
    <children>
        <BorderPane styleClass="window-frame">
            <top>
                <VBox>
                    <children>
                        <fx:include fx:id="titleBar" source="title-bar.fxml"/>
                        <fx:include fx:id="tabStrip" source="tab-strip.fxml"/>
                        <fx:include fx:id="navigationBar" source="navigation-bar.fxml"/>
                    </children>
                </VBox>
            </top>
            <center>
                <StackPane styleClass="workspace">
                    <children>
                        <BorderPane>
                            <left>
                                <fx:include fx:id="sidebar" source="sidebar.fxml"/>
                            </left>
                            <center>
                                <StackPane fx:id="contentSurface"
                                           styleClass="content-surface">
                                    <children>
                                        <WebView fx:id="webView"
                                                 visible="false"
                                                 managed="false"/>
                                        <fx:include fx:id="startPage"
                                                    source="start-page.fxml"/>
                                    </children>
                                </StackPane>
                            </center>
                        </BorderPane>

                        <fx:include fx:id="sidebarPanel"
                                    source="sidebar-panel.fxml"
                                    translateX="68.0"
                                    StackPane.alignment="CENTER_LEFT"/>

                        <fx:include fx:id="easySetup"
                                    source="easy-setup.fxml"
                                    visible="false"
                                    managed="false"
                                    StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10.0" right="10.0"/>
                            </StackPane.margin>
                        </fx:include>
                    </children>
                </StackPane>
            </center>
        </BorderPane>
    </children>
</StackPane>
