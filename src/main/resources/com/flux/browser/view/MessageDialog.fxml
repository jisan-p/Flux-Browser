<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.flux.browser.controller.MessageDialogController"
      prefWidth="460" spacing="20" styleClass="dialog-root" stylesheets="@../style.css">
    <Label text="FLUX" styleClass="eyebrow"/>
    <Label fx:id="heading" text="Confirm action" styleClass="dialog-heading" wrapText="true"/>
    <Label fx:id="messageLabel" text="Continue with this action?" maxWidth="400" wrapText="true"/>
    <TextField fx:id="inputField" visible="false" managed="false" accessibleText="Response to website prompt"/>
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="cancelButton" text="Cancel" onAction="#cancel" cancelButton="true" styleClass="secondary-button"/>
        <Button fx:id="acceptButton" text="Continue" onAction="#accept" defaultButton="true" styleClass="primary-button"/>
    </HBox>
</VBox>
