<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import javafx.scene.image.*?>
<VBox fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.flux.browser.controller.DialTileController"
 prefWidth="144" minWidth="90" prefHeight="112" alignment="TOP_CENTER" spacing="7" styleClass="dial-tile" stylesheets="@../style.css" onContextMenuRequested="#contextMenu">
<fx:define><ContextMenu fx:id="tileMenu" styleClass="gx-context-menu"><items>
<MenuItem text="Open" onAction="#open"/><MenuItem fx:id="newTabItem" text="Open in New Tab" onAction="#openNew"/><MenuItem text="Copy Address" onAction="#copy"/>
<SeparatorMenuItem/><MenuItem fx:id="editItem" text="Edit" onAction="#edit"/><MenuItem fx:id="deleteItem" text="Remove" onAction="#delete"/>
</items></ContextMenu></fx:define>
 <Button fx:id="openButton" onAction="#open" maxWidth="Infinity" prefHeight="86" minHeight="86" alignment="CENTER" styleClass="dial-open">
  <graphic><StackPane minWidth="80">
   <Label fx:id="monogram" text="G" alignment="CENTER" styleClass="dial-monogram"/>
   <ImageView fx:id="iconView" fitWidth="48" fitHeight="48" preserveRatio="true"/>
  </StackPane></graphic>
 </Button>
 <HBox alignment="CENTER" spacing="4"><Label fx:id="titleLabel" text="GitHub" styleClass="dial-title" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/><Button fx:id="editButton" text="•••" onAction="#edit" styleClass="tile-action" accessibleText="Edit shortcut"/><Button fx:id="deleteButton" text="×" onAction="#delete" styleClass="tile-action" accessibleText="Remove shortcut"/></HBox>
 <Label fx:id="domainLabel" visible="false" managed="false"/>
</VBox>
