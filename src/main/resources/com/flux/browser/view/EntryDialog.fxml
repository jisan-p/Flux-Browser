<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.flux.browser.controller.EntryDialogController"
      prefWidth="470" spacing="18" styleClass="dialog-root" stylesheets="@../style.css">
    <Label text="SAVE A DESTINATION" styleClass="eyebrow"/>
    <Label fx:id="heading" text="Add a bookmark" styleClass="dialog-heading"/>
    <VBox spacing="8">
        <Label text="Title" labelFor="$titleField"/>
        <TextField fx:id="titleField" promptText="Give this site a name"/>
    </VBox>
    <VBox spacing="8">
        <Label text="Web address" labelFor="$urlField"/>
        <TextField fx:id="urlField" promptText="https://example.com"/>
    </VBox>
    <VBox fx:id="categoryBox" spacing="8">
        <Label text="Folder" labelFor="$categoryField"/>
        <TextField fx:id="categoryField" text="Unsorted" promptText="Unsorted"/>
    </VBox>
    <Label fx:id="errorLabel" text="" wrapText="true" maxWidth="410" styleClass="error-label" visible="false" managed="false"/>
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="cancelButton" text="Cancel" onAction="#cancel" cancelButton="true" styleClass="secondary-button"/>
        <Button fx:id="saveButton" text="Save destination" onAction="#save" defaultButton="true" styleClass="primary-button"/>
    </HBox>
</VBox>
