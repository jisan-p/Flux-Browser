<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.flux.browser.controller.ManagerHeaderController" alignment="CENTER" styleClass="manager-header">
 <Region HBox.hgrow="ALWAYS"/>
 <Button text="HISTORY" userData="History" onAction="#navigate" styleClass="manager-tab"/>
 <Button text="DOWNLOADS" userData="Downloads" onAction="#navigate" styleClass="manager-tab"/>
 <Button text="SETTINGS" userData="Settings" onAction="#navigate" styleClass="manager-tab"/>
 <Button text="BOOKMARKS" userData="Bookmarks" onAction="#navigate" styleClass="manager-tab"/>
 <Region HBox.hgrow="ALWAYS"/>
 <Button text="×" onAction="#dismiss" styleClass="text-button" accessibleText="Back to browsing"/>
</HBox>
